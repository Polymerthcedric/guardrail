#!/bin/sh
# NetworkManager dispatcher: keep the guardrail resolver's upstream DNS in
# sync with the active connection. Installed to
# /etc/NetworkManager/dispatcher.d/90-guardrail-dns (root:root, 0755).
case "$2" in
  up|dhcp4-change|dhcp6-change|connectivity-change)
    [ -x /usr/local/bin/guardrail-upstream ] && /usr/local/bin/guardrail-upstream
    ;;
esac
