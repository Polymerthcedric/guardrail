#!/bin/sh
# Generate dnsmasq's upstream servers from the current network.
#
# Installed to /usr/local/bin/guardrail-upstream and run by the NetworkManager
# dispatcher (and at install/focus time). The servers written are the *real*
# network DNS; loopback is filtered out so dnsmasq can never forward to itself
# or back into systemd-resolved. That matters because /etc/resolv.conf points
# at dnsmasq: if dnsmasq forwarded to resolved's stub (127.0.0.53), and resolved
# imported 127.0.0.1 from /etc/resolv.conf as its own upstream, the two would
# forward to each other forever (a loop that times every lookup out).
set -eu

CONF=/etc/dnsmasq.d/guardrail-upstream.conf

# NetworkManager exports these when running dispatcher scripts.
servers="${IP4_NAMESERVERS:-} ${IP6_NAMESERVERS:-}"

# Fallback for manual runs: read the real per-link servers from resolved.
if [ -z "$(printf '%s' "$servers" | tr -d '[:space:]')" ]; then
  servers=$(resolvectl dns 2>/dev/null \
    | awk '/\(/{for(i=4;i<=NF;i++)print $i} /^Global:/{for(i=2;i<=NF;i++)print $i}' || true)
fi

tmp=$(mktemp)
{
  echo "# Generated by guardrail-upstream — real upstream DNS. Do not edit."
  printf '%s\n' $servers | while read -r s; do
    [ -z "$s" ] && continue
    case "$s" in
      127.*|::1|*%*|fe80:*) continue ;;
    esac
    echo "server=$s"
  done
} > "$tmp"

if [ "$(grep -c '^server=' "$tmp" || true)" -gt 0 ]; then
  mv "$tmp" "$CONF"
  chmod 0644 "$CONF"
  # A restart (not SIGHUP reload) is required for dnsmasq to re-read server=.
  systemctl restart dnsmasq 2>/dev/null || true
else
  rm -f "$tmp"
fi
